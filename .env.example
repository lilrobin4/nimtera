# GEMINI_API_KEY: Optional AI Studio environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public canonical URL for NimTera (https://nimtera.store in production)
APP_URL="https://nimtera.store"

# SESSION_SECRET: High-entropy secret for signing seller session tokens
SESSION_SECRET=

# TURNSTILE_SITE_KEY & TURNSTILE_SECRET_KEY: Cloudflare Turnstile CAPTCHA configuration
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ALLOWLISTED UPSTREAM RPC ENDPOINTS (Strictly separated per network, no arbitrary proxy)
NIMIQ_TESTNET_RPC_URL="https://rpc.nimiq-testnet.com"
NIMIQ_MAINNET_RPC_URL="https://rpc.nimiq.network"
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
POLYGON_MAINNET_RPC_URL="https://polygon-rpc.com"

# POLYGON MAINNET USDT CONTRACT (Chain ID 137, Verified 6 decimals — NEVER use on Amoy)
POLYGON_USDT_CONTRACT="0xc2132D05D31c914a87C6611C10748AEb04B58e8F"

# POLYGON AMOY TEST TOKEN CONTRACT (Chain ID 80002, 6 decimals ERC-20 TEST TOKEN)
# Leave empty until an approved Amoy ERC-20 test token contract is configured or deployed with user approval.
POLYGON_AMOY_TEST_TOKEN_CONTRACT=""

