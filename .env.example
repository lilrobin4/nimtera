# Local single-server TESTNET beta. Never commit .env or your data directory.
# Generate your own random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
APP_URL=http://localhost:3000
PORT=3000
# Keep the database outside public/static directories; one process only.
NIMTERA_DATA_FILE=.data/store.json

# Server-only RPC endpoints, no browser-supplied endpoints or cross-chain fallback.
NIMIQ_TESTNET_RPC_URL=https://rpc.testnet.nimiqwatch.com

# Mainnet is hard-disabled in this beta; no environment toggle can enable it.

# Vercel full app: use a dedicated TESTNET PostgreSQL database, never shared production data.
# Configure this privately in Vercel Environment Variables. Use a pooled URL with TLS.
DATABASE_URL=
# Cloud entrypoint initializes migrations/001-testnet-state.sql without importing demo data.
